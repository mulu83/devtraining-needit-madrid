{
  "table": {
    "displayName": "AI Use Case",
    "pluralDisplayName": "AI Use Cases",
    "logicalName": "efta_aiusecase",
    "description": "Registry of AI and automation initiatives across EFTA",
    "ownership": "UserOwned",
    "columns": [
      {
        "displayName": "Case ID",
        "logicalName": "efta_caseid",
        "type": "AutoNumber",
        "format": "EFTA-AI-{SEQNUM:5}",
        "isPrimaryField": false,
        "description": "Auto-generated unique identifier"
      },
      {
        "displayName": "Title",
        "logicalName": "efta_title",
        "type": "SingleLineText",
        "maxLength": 150,
        "required": true,
        "isPrimaryField": true,
        "description": "Short descriptive title generated by the agent"
      },
      {
        "displayName": "Submitted By",
        "logicalName": "efta_submittedby",
        "type": "Lookup",
        "relatedTable": "systemuser",
        "required": true,
        "description": "Auto-populated from M365 authenticated session"
      },
      {
        "displayName": "Submission Date",
        "logicalName": "efta_submissiondate",
        "type": "DateOnly",
        "defaultValue": "today",
        "required": true
      },
      {
        "displayName": "Domain",
        "logicalName": "efta_domain",
        "type": "Choice",
        "required": true,
        "choices": [
          { "value": 1, "label": "Finance & Budget" },
          { "value": 2, "label": "Legal & Compliance" },
          { "value": 3, "label": "Trade & Statistics" },
          { "value": 4, "label": "HR & Workforce" },
          { "value": 5, "label": "IT & Infrastructure" },
          { "value": 6, "label": "Communications & Outreach" },
          { "value": 7, "label": "Policy & Analysis" },
          { "value": 8, "label": "Other" }
        ]
      },
      {
        "displayName": "Problem Statement",
        "logicalName": "efta_problemstatement",
        "type": "MultilineText",
        "maxLength": 2000,
        "required": true,
        "description": "What problem or opportunity was addressed"
      },
      {
        "displayName": "Tool or Technology Used",
        "logicalName": "efta_toolused",
        "type": "Choice",
        "required": true,
        "choices": [
          { "value": 1, "label": "Microsoft Copilot" },
          { "value": 2, "label": "Claude (Anthropic)" },
          { "value": 3, "label": "Azure AI Services" },
          { "value": 4, "label": "Power Automate" },
          { "value": 5, "label": "Power BI" },
          { "value": 6, "label": "GitHub Copilot" },
          { "value": 7, "label": "Custom ML Model" },
          { "value": 8, "label": "Other" }
        ]
      },
      {
        "displayName": "Tool Detail (if Other)",
        "logicalName": "efta_tooldetail",
        "type": "SingleLineText",
        "maxLength": 200,
        "required": false,
        "description": "Free text when Tool = Other"
      },
      {
        "displayName": "Outcome",
        "logicalName": "efta_outcome",
        "type": "MultilineText",
        "maxLength": 2000,
        "required": true,
        "description": "What was achieved — quantified where possible"
      },
      {
        "displayName": "Key Learning",
        "logicalName": "efta_keylearning",
        "type": "MultilineText",
        "maxLength": 2000,
        "required": true,
        "description": "What others should know before attempting something similar"
      },
      {
        "displayName": "Visibility",
        "logicalName": "efta_visibility",
        "type": "Choice",
        "required": true,
        "defaultValue": 1,
        "choices": [
          { "value": 1, "label": "Internal only" },
          { "value": 2, "label": "Management" },
          { "value": 3, "label": "Public" }
        ]
      },
      {
        "displayName": "Status",
        "logicalName": "efta_status",
        "type": "Choice",
        "required": true,
        "defaultValue": 1,
        "choices": [
          { "value": 1, "label": "Draft" },
          { "value": 2, "label": "Pending Approval" },
          { "value": 3, "label": "Approved" },
          { "value": 4, "label": "Published" },
          { "value": 5, "label": "Rejected" }
        ]
      },
      {
        "displayName": "Approver Notes",
        "logicalName": "efta_approvernotes",
        "type": "MultilineText",
        "maxLength": 1000,
        "required": false,
        "description": "Reviewer feedback — visible to submitter"
      }
    ]
  }
}
